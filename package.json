{
  "name": "csharp-oonv-kurz",
  "version": "1.0.0",
  "private": true,
  "description": "C# & OONV Interactive Learning Platform",
  "scripts": {
    "setup:linux": "bash ./setup-linux.sh",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File ./setup-windows.ps1 -InstallOnly",
    "start:windows": "powershell -ExecutionPolicy Bypass -File ./setup-windows.ps1",
    "start:server": "cd server && npm start",
    "test:server": "cd server && npm test",
    "build:client": "cd client && npm run build",
    "start:client": "cd client && npm run dev",
    "launch": "./bin/launch-app.sh",
    "launch:chromium": "./bin/launch-app.sh --browser=chromium",
    "launch:librewolf": "./bin/launch-app.sh --browser=librewolf"
  }
}
